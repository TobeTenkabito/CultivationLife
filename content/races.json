  "races": [
    {"id":"human","name":"人族","worlds":["human","spirit","true_demon","celestial"],"description":"凭功法、器物与宗门传承立足诸界；飞升者在仙界与真魔界均建立了独立道统。"},
    {"id":"monster","name":"妖族","worlds":["human","spirit"],"description":"由天地生灵启智化形，肉身与血脉天赋强盛。"},
    {"id":"spirit","name":"灵族","worlds":["spirit"],"description":"由精纯灵气孕育，天生亲近天地元气。"},
    {"id":"woodborn","name":"木生族","worlds":["spirit"],"description":"诞生于古木年轮，擅长生机与恢复。"},
    {"id":"seafolk","name":"沧海族","worlds":["spirit"],"description":"栖居浮海与云潮之间，可御万顷灵水。"},
    {"id":"featherfolk","name":"羽民族","worlds":["spirit"],"description":"背生灵羽，遁速冠绝多数陆生族群。"},
    {"id":"stoneborn","name":"石胎族","worlds":["spirit"],"description":"山心石胎化生，肉身坚若灵矿。"},
    {"id":"cloudkin","name":"云蜕族","worlds":["spirit"],"description":"形体可聚可散，常居高空云城。"},
    {"id":"thunderkin","name":"雷泽族","worlds":["spirit"],"description":"生于雷泽深处，以天雷淬炼经脉。"},
    {"id":"crystalfolk","name":"晶曜族","worlds":["spirit"],"description":"晶体脉络可储存庞大灵力。"},
    {"id":"starborn","name":"星裔族","worlds":["spirit"],"description":"借星辉修炼，神识在夜间尤为敏锐。"},
    {"id":"moonfolk","name":"月民族","worlds":["spirit"],"description":"居于永夜月湖，擅长幻光与隐匿。"},
    {"id":"magnetfolk","name":"金磁族","worlds":["spirit"],"description":"能感应金石磁脉，克制寻常金铁法器。"},
    {"id":"silkkin","name":"天蚕族","worlds":["spirit"],"description":"每次蜕变都会强化神魂与护体灵丝。"},
    {"id":"miragefolk","name":"蜃景族","worlds":["spirit"],"description":"以海市蜃楼筑城，虚实变化难辨。"},
    {"id":"sunwing","name":"曜羽族","worlds":["spirit"],"description":"羽翼蕴含日精，克制阴寒术法。"},
    {"id":"horned_drake","name":"苍角族","worlds":["spirit"],"description":"头生苍角，可引动地脉与山岳之力。"},
    {"id":"frostfolk","name":"霜华族","worlds":["spirit"],"description":"由极寒灵雾凝形，喜居冰原。"},
    {"id":"sandkin","name":"流沙族","worlds":["spirit"],"description":"身躯能散作灵沙，穿行荒漠地底。"},
    {"id":"insectkin","name":"虫灵族","worlds":["spirit"],"description":"族群分支众多，以群体感知和蜕壳闻名。"},
    {"id":"ancient_demon","name":"始魔族","worlds":["true_demon"],"description":"真魔界最古老的原生族群之一，魔躯强横，以血脉年代划分尊卑。"},
    {"id":"heaven_demon","name":"天魔族","worlds":["true_demon"],"description":"无固定肉身，善循心障降临并侵夺识海，以神魂秘术闻名。"},
    {"id":"blood_demon","name":"血魔族","worlds":["true_demon"],"description":"生于魔血长河，可燃精血重塑魔躯，与魂魔族缔有古盟。"},
    {"id":"shadow_demon","name":"影魔族","worlds":["true_demon"],"description":"栖身无光之地，能够在阴影间迁跃，尤擅伏杀与潜踪。"},
    {"id":"bone_demon","name":"骨魔族","worlds":["true_demon"],"description":"以魔骨为甲、骨髓为炉，死亡后残骸仍可孕育新的族裔。"},
    {"id":"nightmare_demon","name":"梦魇族","worlds":["true_demon"],"description":"以众生梦境和恐惧为食，能令敌手在幻梦中耗尽元神。"},
    {"id":"flame_demon","name":"炎魔族","worlds":["true_demon"],"description":"诞生于地肺魔焰，性情猛烈，与寒魔族争夺冷热魔脉。"},
    {"id":"frost_demon","name":"寒魔族","worlds":["true_demon"],"description":"以玄冥寒煞凝体，可冻结法力流转，与炎魔族世代血战。"},
    {"id":"rock_demon","name":"岩魔族","worlds":["true_demon"],"description":"背负魔山而生，行动迟缓却几乎无法被同阶正面撼动。"},
    {"id":"winged_demon","name":"翼魔族","worlds":["true_demon"],"description":"生有多对刃翼，占据高空魔巢，以高速围猎和军阵著称。"},
    {"id":"abyss_demon","name":"渊魔族","worlds":["true_demon"],"description":"来自地底裂渊的庞然魔物，能吞纳浊气并在黑暗中持续生长。"},
    {"id":"soul_demon","name":"魂魔族","worlds":["true_demon"],"description":"肉身只是容器，真正本体是聚散无常的魔魂，精于夺舍和御魂。"},
    {"id":"corpse_demon","name":"尸魔族","worlds":["true_demon"],"description":"由万年古尸自行诞灵，并非受人操纵的炼尸，肉身不腐不灭。"},
    {"id":"witch_demon","name":"巫魔族","worlds":["true_demon"],"description":"以祭坛、咒血和祖灵沟通界外伟力，部族由十二巫脉共同议事。"},
    {"id":"horn_demon","name":"角魔族","worlds":["true_demon"],"description":"魔角可聚集地脉煞力，崇尚角斗与力量，常受黑日诸宗招揽。"},
    {"id":"many_eye_demon","name":"千目族","worlds":["true_demon"],"description":"周身魔眼各具异能，能窥法力节点、识破幻术并放出灭魂邪光。"},
    {"id":"insect_demon","name":"群甲魔族","worlds":["true_demon"],"description":"由母巢统合的魔虫群落，繁衍迅猛，所过之处连魔气也会被吞空。"},
    {"id":"sea_demon","name":"海魔族","worlds":["true_demon"],"description":"盘踞腐海与魔潮，能够驾驭黑水，与渊魔族共同维持渊海盟约。"},
    {"id":"void_demon","name":"虚魔族","worlds":["true_demon"],"description":"诞生于界壁裂隙，形体时隐时现，天生能够感应空间薄弱之处。"}
  ]
