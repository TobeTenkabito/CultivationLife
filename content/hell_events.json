    {"id":"EVT_HELL_JOIN_PASSAGE_001","version":1,"title":"幽关点灯","body":"幽关渡院在城楼下重燃引魂灯，招收愿意护送迷魂、勘验来路的修士。","category":"hell_faction","tags":["hell_common","faction_join"],"weight":4,"repeat":"once","conditions":{"all":[{"path":"player.faction_id","op":"eq","value":null},{"path":"player.realm_index","op":"gte","value":1}]},"choices":[{"id":"join","text":"接过渡灯，拜入幽关渡院","effects":[{"type":"join_faction","faction_id":"ghost_passage_court"}]},{"id":"leave","text":"暂不受院规约束","effects":[]}]},
    {"id":"EVT_HELL_JOIN_ARCHIVE_001","version":1,"title":"书楼问名","body":"忘川书楼以一段无主记忆为题，能辨明其中真伪而不沉溺者，可在书楼留名。","category":"hell_faction","tags":["hell_common","faction_join"],"weight":4,"repeat":"once","conditions":{"all":[{"path":"player.faction_id","op":"eq","value":null},{"path":"player.realm_index","op":"gte","value":1}]},"choices":[{"id":"join","text":"照见记忆本末，拜入忘川书楼","effects":[{"type":"join_faction","faction_id":"forgetful_river_archive"}]},{"id":"leave","text":"封回记忆，转身离开","effects":[{"type":"add_opportunity","value":4}]}]},
    {"id":"EVT_HELL_JOIN_PRISON_001","version":1,"title":"铁树试身","body":"铁树狱门开放一段阴风刑道，能护住魂体走完全程者，便有资格学习镇狱之法。","category":"hell_faction","tags":["hell_common","faction_join"],"weight":4,"repeat":"once","conditions":{"all":[{"path":"player.faction_id","op":"eq","value":null},{"path":"player.realm_index","op":"gte","value":1}]},"choices":[{"id":"join","text":"走过刑道，拜入铁树狱门","effects":[{"type":"join_faction","faction_id":"iron_tree_prison_sect"}]},{"id":"leave","text":"记下风路后离开","effects":[{"type":"restore_mp","value":0.06}]}]},
    {"id":"EVT_HELL_FACTION_DUTY_001","version":1,"title":"宗门阴契","body":"宗门接到一份公共阴契：清点迷魂、修补渡口，或加固铁树荒原的一段镇魂桩。","category":"hell_faction","tags":["hell_common","faction","duty"],"weight":6,"conditions":{"path":"player.faction_id","op":"neq","value":null},"choices":[{"id":"serve","text":"按契完成本门职责","effects":[{"type":"restore_mp","value":-0.08},{"type":"add_faction_contribution","value":5},{"type":"add_fame","value":3}]},{"id":"study","text":"校订阴契中的魂印错漏","effects":[{"type":"add_faction_contribution","value":3},{"type":"add_opportunity","value":9}]}]},
    {"id":"EVT_HELL_COMMON_001","version":1,"title":"哭魂桥断流","body":"忘川一条支流忽然断绝，桥下积满无法前行的残魂。它们争着诉说生前最后一句话，桥身已被念力压出裂纹。","category":"hell_common","tags":["hell_common","travel","soul"],"weight":7,"intent_weights":{"travel":2.0,"commission":1.8},"choices":[{"id":"guide","text":"逐一辨明来路，引残魂改道","effects":[{"type":"restore_mp","value":-0.10},{"type":"add_karma","value":-4},{"type":"add_fame","value":4}]},{"id":"brace","text":"先以阴气托住桥身","effects":[{"type":"add_opportunity","value":9}]},{"id":"leave","text":"避开拥堵的魂潮","effects":[]}]},
    {"id":"EVT_HELL_COMMON_002","version":1,"title":"无主命灯","body":"幽关墙根下有一盏命灯独自燃烧，灯芯没有姓名，火光却会随每个路人的呼吸明灭。","category":"hell_common","tags":["hell_common","treasure","mystery"],"weight":6,"intent_weights":{"treasure":2.0,"cultivate":1.4},"choices":[{"id":"guard","text":"守到灯火自行熄灭","effects":[{"type":"add_opportunity","value":11},{"type":"add_karma","value":-2}]},{"id":"take","text":"收起命灯残座","effects":[{"type":"add_item","item_id":"soul_lamp"},{"type":"add_karma","value":4}]},{"id":"trace","text":"循灯火追查无名魂的去处","effects":[{"type":"restore_mp","value":-0.08},{"type":"add_fame","value":3}]}]},
    {"id":"EVT_HELL_COMMON_003","version":1,"title":"铁树换叶","body":"铁树荒原一株老树褪下锈黑旧叶，露出的新叶像薄刃一样震鸣。附近阴魂不敢靠近，狱门修士却说这是难得的锻魂时机。","category":"hell_common","tags":["hell_common","cultivation","body"],"weight":6,"intent_weights":{"cultivate":1.8,"treasure":1.5},"conditions":{"path":"player.realm_index","op":"gte","value":2},"choices":[{"id":"temper","text":"借叶鸣淬炼魂体","effects":[{"type":"damage","value":0.07,"reason":"铁叶阴雷割伤魂体"},{"type":"add_opportunity","value":12,"if_result":["injured"]}]},{"id":"collect","text":"待雷音散尽后收取树心","effects":[{"type":"add_item","item_id":"iron_tree_heartwood"}]},{"id":"shield","text":"替周围低阶阴魂挡下叶雨","effects":[{"type":"add_karma","value":-5},{"type":"add_fame","value":4}]}]},
    {"id":"EVT_HELL_COMMON_004","version":1,"title":"狱火误判","body":"一缕狱火追着一名送信小鬼不放。它身上的罪印确实为真，却来自生前被迫代人画押的一纸伪契。","category":"hell_common","tags":["hell_common","karma","encounter"],"weight":5,"intent_weights":{"commission":1.8,"travel":1.4},"choices":[{"id":"prove","text":"拆开伪契，替它重验因果","effects":[{"type":"restore_mp","value":-0.12},{"type":"add_karma","value":-6},{"type":"add_fame","value":5}]},{"id":"bind","text":"先收走狱火，等日后再查","effects":[{"type":"add_opportunity","value":8},{"type":"add_karma","value":2}]},{"id":"ignore","text":"不干预地狱界旧判","effects":[]}]},
    {"id":"EVT_HELL_COMMON_005","version":1,"title":"九狱回声","body":"九重狱境深处传来一声与你完全相同的叹息。那不是幻术，而是你曾经放弃的一种选择在阴气中留下的回声。","category":"hell_common","tags":["hell_common","cultivation","nine_prison"],"weight":5,"intent_weights":{"cultivate":2.0,"rest":1.4},"conditions":{"path":"player.realm_index","op":"gte","value":6},"choices":[{"id":"answer","text":"与回声对坐，问清当日得失","effects":[{"type":"add_heart_demon","value":-4},{"type":"add_opportunity","value":16}]},{"id":"cut","text":"斩断回声，不让旧念扰道","effects":[{"type":"restore_mp","value":0.12}]},{"id":"keep","text":"将回声留作一面心镜","effects":[{"type":"add_opportunity","value":10},{"type":"add_heart_demon","value":2}]}]},
    {"id":"EVT_HELL_COMBAT_001","version":1,"title":"失控缚魂索","body":"一条镇守幽关的缚魂索失去主人后自行捕捉过往阴魂。它已把数十道残魂拧成一团，战力约为{target_power}。","category":"hell_combat","tags":["hell_common","combat","negative"],"weight":6,"intent_weights":{"travel":2.0,"commission":2.2},"combat":{"target_name":"失控缚魂索","combat_type":"beast","action":"hunt_beast","success_threshold":1.0,"realm_offsets":[[-1,0.22],[0,0.68],[1,0.10]],"expectation_multiplier":1.0,"power_sigma":0.15,"power_bounds":[0.64,1.42],"max_rounds":6},"choices":[{"id":"break","text":"按战斗预案斩断缚魂索","effects":[{"type":"runtime_combat","lethal":true},{"type":"add_item","item_id":"yin_soul_stone","if_result":["killed"]}]},{"id":"avoid","text":"收敛魂光绕道而行","effects":[{"type":"restore_mp","value":-0.08}]}]},
    {"id":"EVT_HELL_COMBAT_002","version":1,"title":"阴身试法","body":"铁树狱门在荒原设下公开试法场，一名同阶修士邀你验证魂体攻守。此战只分胜负，不伤本源。","category":"hell_combat","tags":["hell_common","combat","social"],"weight":5,"intent_weights":{"cultivate":1.8,"travel":1.5},"combat":{"target_name":"狱门试法修士","realm_offsets":[[-1,0.12],[0,0.76],[1,0.12]],"expectation_multiplier":1.0,"power_sigma":0.13,"power_bounds":[0.70,1.34],"max_rounds":6},"choices":[{"id":"fight","text":"按战斗预案完成试法","effects":[{"type":"runtime_combat","lethal":false},{"type":"add_opportunity","value":10}]},{"id":"observe","text":"观摩双方魂光流转","effects":[{"type":"add_opportunity","value":6}]}]},
    {"id":"EVT_HELL_MEMORY_001","version":1,"title":"忘川失名舟","body":"一艘无人撑渡的小舟逆流而来，船舱里没有乘客，只有数百枚被磨去姓名的木牌。每枚木牌都保存着同一段求救声。","category":"hell_story","tags":["hell_common","story_chain","forgetful_memory"],"weight":3,"repeat":"once","conditions":{"path":"player.realm_index","op":"gte","value":5},"choices":[{"id":"board","text":"登舟追查求救声的源头","effects":[{"type":"queue_event","event_id":"EVT_HELL_MEMORY_002"}]},{"id":"moor","text":"将小舟系回渡口等待失主","effects":[{"type":"add_karma","value":-3},{"type":"add_fame","value":3}]},{"id":"leave","text":"不碰来历不明的无名牌","effects":[]}]},
    {"id":"EVT_HELL_MEMORY_002","version":1,"title":"被抹去的渡册","body":"小舟驶入一片静水，水下沉着半部渡册。有人把一批已经通过幽关的亡魂从记录中抹去，再将它们的记忆拆散卖给鬼市。求救声正来自这些尚未售出的记忆。","category":"hell_story","tags":["hell_common","story_chain","forgetful_memory","manual_only"],"weight":0,"choices":[{"id":"salvage","text":"潜入静水捞出渡册","effects":[{"type":"damage","value":0.10,"reason":"静水中的无主记忆冲击识海"},{"type":"queue_event","event_id":"EVT_HELL_MEMORY_003","if_result":["injured"]}]},{"id":"trace","text":"以神识反查鬼市买家的魂印","effects":[{"type":"restore_mp","value":-0.18},{"type":"queue_event","event_id":"EVT_HELL_MEMORY_003"}]},{"id":"burn","text":"烧掉木牌，让残念不再受人买卖","effects":[{"type":"add_karma","value":-5},{"type":"add_opportunity","value":10}]}]},
    {"id":"EVT_HELL_MEMORY_003","version":1,"title":"归还姓名","body":"渡册末页记录了真相：负责转运的旧吏并非为财，而是想把亲族从轮回名册中偷出来，结果中间人趁机复制了数百份无辜记忆。旧吏已经认罪，受害亡魂却仍在等自己的姓名。","category":"hell_story","tags":["hell_common","story_chain","forgetful_memory","manual_only"],"weight":0,"choices":[{"id":"return","text":"逐一归还姓名，再将旧吏交给幽关重审","effects":[{"type":"add_item","item_id":"memory_pearl"},{"type":"add_karma","value":-10},{"type":"add_fame","value":10},{"type":"set_flag","flag":"hell_memory_names_returned"}]},{"id":"archive","text":"把受害记忆交给书楼封存并传下辨念之法","effects":[{"type":"learn_technique","technique_id":"TECH_FORGETFUL_RIVER_SENSE"},{"type":"add_karma","value":-5},{"type":"set_flag","flag":"hell_memory_archive_completed"}]},{"id":"erase","text":"抹去所有牵连者记忆，让此案永远消失","effects":[{"type":"add_item","item_id":"memory_pearl","quantity":2},{"type":"add_karma","value":12},{"type":"set_flag","flag":"hell_memory_case_erased"}]}]}
  ]
