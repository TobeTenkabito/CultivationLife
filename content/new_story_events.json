        {"id":"leave","text":"不入沧海宫","effects":[]}
      ]
    },
    {
      "id":"EVT_XUTIAN_002","version":1,"title":"三门夺路","body":"外宫尽头分出三条旧路：玄冰门直通丹殿，却有万载寒气封道；赤火门绕经地肺，路远但可借火炼体；白玉门看似最近，门后却不断传来失踪修士的求救声。",
      "tags":["realm:core","world:human","story_chain","xutian","manual_only"],"weight":0,
      "conditions":{"has_flag":"xutian_entered"},
      "choices":[
        {"id":"ice","text":"运功护住金丹，穿过玄冰门","effects":[{"type":"restore_mp","value":-0.12},{"type":"set_flag","flag":"xutian_ice_path"},{"type":"queue_event","event_id":"EVT_XUTIAN_003"}]},
        {"id":"fire","text":"借熔岩火煞淬炼护体灵光","effects":[{"type":"damage","value":0.18,"reason":"葬身熔岩火煞"},{"type":"queue_event","event_id":"EVT_XUTIAN_003","if_result":["injured"]}]},
