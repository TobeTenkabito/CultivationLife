        {"id":"decline","text":"不愿卷入天衡山内争","effects":[{"type":"add_karma","value":-2}]}
      ]
    },
    {
      "id":"EVT_GUANGHAN_001","version":1,"title":"青冥洞天开启","body":"灵界各族供奉的青冥古令同时发出清鸣，三千年一开的青冥洞天再次现世。此界曾是上古木修培育灵药之所，如今界树衰败、天幕开裂，最多只能维持百日。炼虚修士既为机缘而来，也都盯上了支撑洞天的最后一枚山灵。",
      "tags":["realm:void","world:spirit","story_chain","guanghan","probability_gate"],"weight":0,"repeat":"once","trigger":{"milestone":"guanghan_eligible","base_chance":0.16,"unit_increment":0.02},
