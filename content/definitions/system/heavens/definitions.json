          "location_id": "law_sea",
          "name": "法则天海 · 潮汐回响",
          "visitor_name": "观澜散人",
          "visitor_path": "dao",
          "spirit_root": "supreme_water",
          "record_id": "karma_city_old_copy",
          "evidence": {
            "$tuple": [
              "潮汐体察",
              "接引碑旧记",
              "因果天城合法抄录"
            ]
          },
          "findings": {
            "$tuple": [
              "每次潮落，阵中的回声总要迟上一拍。你听了几轮，次次如此。",
              "接引碑上先后两段旧记都记着这半拍的迟滞。照碑文所记吐纳，正好赶上回潮。",
              "你把因果天城的旧图摊在潮刻旁。旧节点每亮一次，此地便起一潮。这回相约查潮的事也有了交代。"
            ]
          },
          "correspondence_years": 10,
          "correspondence_stones": 2500
        },
        {
          "$record": "ContactSite",
          "id": "asura_echo",
          "world": "asura",
          "location_id": "destruction_sea",
          "name": "寂灭海 · 战律余响",
          "visitor_name": "止戈客",
          "visitor_path": "demonic",
          "spirit_root": "mutated_thunder",
          "record_id": "celestial_seal_copy",
          "evidence": {
            "$tuple": [
              "战律余响",
              "古战阵铭",
              "仙界封阵抄录"
            ]
          },
          "findings": {
            "$tuple": [
              "守军早已收兵，寂灭海深处却又传出一阵有节律的震响。",
              "你从阵铭上找到两段休战的日子。那几年兵马未动，海中的余响依旧如期而至。",
              "你将封阵拓片与海边的铭文相对，两界旧阵的纹路恰好首尾相接。一端震动，另一端便有回响。"
            ]
          },
          "correspondence_years": 10,
          "correspondence_stones": 2500
        },
        {
          "$record": "ContactSite",
          "id": "nether_echo",
          "world": "nether",
          "location_id": "world_tree_crown",
          "name": "界树天冠 · 万灵年轮",
          "visitor_name": "听木叟",
          "visitor_path": "monster",
          "spirit_root": "supreme_wood",
          "record_id": "asura_growth_copy",
          "evidence": {
            "$tuple": [
              "万灵年轮",
              "树冠旧痕",
              "修罗古木抄录"
            ]
          },
          "findings": {
            "$tuple": [
              "灵潮已歇，世界树深处仍传来一阵轻颤。你贴近树干，手掌下的年轮又动了一次。",
              "树冠的旧痕分作两层。几族修士各自记下树身震动的时刻，摊开一对，竟刻刻相合。",
              "你顺着古木拓本上的轮纹看去，修罗界旧阵每动一次，轮纹便深一分。记下这个间隔，平日参悟时用得上。"
            ]
          },
          "correspondence_years": 10,
          "correspondence_stones": 2500
        },
        {
          "$record": "ContactSite",
          "id": "reincarnation_echo",
          "world": "reincarnation",
          "location_id": "karma_city",
          "name": "因果天城 · 三生回照",
          "visitor_name": "照尘居士",
          "visitor_path": "ghost",
          "spirit_root": "supreme_water",
          "record_id": "nether_ring_copy",
          "evidence": {
            "$tuple": [
              "三生回照",
              "因果碑旧记",
              "幽冥年轮抄录"
            ]
          },
          "findings": {
            "$tuple": [
              "碑前人影来去，衣冠相隔数代，脚下的石阶却是同一块。",
              "碑上两处旧刻相继泛光。你这才认出，刚才那两道人影各从一道刻痕中走出。",
              "你依年轮抄本排好先后。幽冥旧节点留下的每一道痕，都能在碑前找到同年的回影。"
            ]
          },
          "correspondence_years": 10,
          "correspondence_stones": 2500
        }
      ]
    },
