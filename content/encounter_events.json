        {"id":"ignore","text":"不作停留","effects":[{"type":"cultivator_reaction","chance":0.16}]}
      ]
    },
    {
      "id":"EVT_ENCOUNTER_JADE_BARTER_001","version":1,"title":"古玉互易","body":"一名识宝修士看中了你收集的古物，提出以养魂材料和一段洞府方位交换。",
