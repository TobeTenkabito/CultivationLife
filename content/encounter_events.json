      "choices":[
        {"id":"help","text":"协力稳定阵眼并平分所得","effects":[{"type":"restore_mp","value":-0.12},{"type":"add_item","item_id":"spirit_stone","quantity":5},{"type":"add_item","item_id":"formation_plate"}]},
        {"id":"advice","text":"指出阵纹错漏，换取一份拓本","effects":[{"type":"add_opportunity","value":9}]},
        {"id":"leave","text":"不愿卷入，转身离开","effects":[{"type":"cultivator_reaction","chance":0.12}]}
      ]
    },
    {
      "id":"EVT_ENCOUNTER_TREASURE_MAP_001","version":1,"title":"残图各半","body":"你与另一名修士各持半幅残缺地形图。对方提议暂时互信，交换拓本后各自寻宝。",
      "category":"encounter","tags":["cultivator","trade","treasure"],"weight":4,"intent_weights":{"travel":2.0,"treasure":2.5},
      "conditions":{"path":"player.realm_index","op":"gte","value":1},
      "choices":[
