        {"id":"share","text":"交换各自掌握的洞府方位","effects":[{"type":"add_opportunity","value":8}]},
        {"id":"dismiss","text":"怀疑其居心，冷言拒绝","effects":[{"type":"cultivator_reaction","chance":0.24}]}
      ]
    },
    {
      "id":"EVT_ENCOUNTER_DAO_DEBATE_001","version":1,"title":"路亭论道","body":"几名境界相近的修士在路亭争论修行关窍，见你经过，邀请你评说一二。",
