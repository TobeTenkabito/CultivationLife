        {"id":"repair","text":"以法力修复跨城传送阵（MP 至少 90,000）","effects":[{"type":"attribute_check","checks":[{"stat":"mp","op":"gte","value":90000},{"stat":"mp_ratio","op":"gte","value":0.55}],"failure_reason":"空间阵纹反噬，元神被撕裂","success_text":"援军与伤员得以往来，城防重新连成一体。"},{"type":"restore_mp","value":-0.18,"if_result":["check_success"]},{"type":"set_flag","flag":"two_realms_portal_saved","if_result":["check_success"]},{"type":"queue_event","event_id":"EVT_TWO_REALMS_003","if_result":["check_success"]}]},
        {"id":"field","text":"出城接回被困修士（HP 至少 75,000）","effects":[{"type":"attribute_check","checks":[{"stat":"hp","op":"gte","value":75000},{"stat":"hp_ratio","op":"gte","value":0.60}],"failure_reason":"真魔战阵突然闭合，你被困死在城外魔潮中","success_text":"你硬受数轮魔焰，把最后一批伤员带回城内。"},{"type":"damage","value":0.16,"if_result":["check_success"]},{"type":"add_karma","value":-5,"if_result":["injured"]},{"type":"queue_event","event_id":"EVT_TWO_REALMS_003","if_result":["injured"]}]},
