        {"id":"both","text":"布阵分化元神，兼取雷池与魂芝（战力 7,200,000；HP、MP 85,000）","effects":[{"type":"attribute_check","checks":[{"stat":"combat_power","op":"gte","value":7200000},{"stat":"hp","op":"gte","value":85000},{"stat":"mp","op":"gte","value":85000}],"failure_reason":"雷火循着分神涌入识海，将你烧成灵光","success_text":"你以阵法稳住肉身和分神，两种造化均未失手。"},{"type":"damage","value":0.20,"if_result":["check_success"]},{"type":"restore_mp","value":-0.20,"if_result":["injured"]},{"type":"set_flag","flag":"bitter_island_bathed"},{"type":"set_flag","flag":"bitter_island_lotus"},{"type":"queue_event","event_id":"EVT_BITTER_ISLAND_005"}]},
