        {"id":"rescue","text":"先迁走魔渊附近的凡人与低阶修士","effects":[{"type":"add_karma","value":-8},{"type":"set_flag","flag":"two_realms_rescuer"},{"type":"queue_event","event_id":"EVT_TWO_REALMS_002"}]},
