    {"id": "monster", "name": "妖族", "worlds": ["human", "spirit", "monster_realm", "phantom_underworld"], "description": "由天地生灵启智化形，肉身与血脉天赋强盛。"},
    {"id": "clawkin", "name": "爪族", "worlds": ["monster_realm"], "description": "虎豹熊罴启智而成的百兽大族，崇尚正面搏杀与山林领地。"},
