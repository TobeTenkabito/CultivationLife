    {"id": "skykin", "name": "天羽族", "worlds": ["monster_realm"], "description": "统御妖界高空与雷云的羽族联盟，以极速和远视闻名。"},
    {"id": "chitinborn", "name": "甲虫族", "worlds": ["monster_realm"], "description": "通过蜕壳不断重塑妖躯，族群感知敏锐且擅长阵战。"},
    {"id": "moonbeast", "name": "月兽族", "worlds": ["phantom_underworld"], "description": "受幻冥月华孕育的兽裔，月盛时妖力与感知一同高涨。"},
    {"id": "dreamfox", "name": "梦狐族", "worlds": ["phantom_underworld"], "description": "能够穿行梦境与现实缝隙的狐裔，极少显露真实形体。"},
    {"id": "treekin", "name": "古木灵族", "worlds": ["phantom_underworld"], "description": "万灵古林的年轮生灵，拥有漫长寿元和强盛恢复能力。"},
    {"id": "boneborn", "name": "天骨族", "worlds": ["phantom_underworld"], "description": "自远古巨兽遗骨中诞灵，骨甲即是肉身也是传承。"},
    {"id": "tidephantom", "name": "幻潮族", "worlds": ["phantom_underworld"], "description": "随幻冥潮汐聚散的水相生灵，难以被寻常兵刃锁定。"},
    {"id": "shadowwing", "name": "冥翼族", "worlds": ["phantom_underworld"], "description": "栖息无月高空的暗羽生灵，擅长潜踪和俯冲猎杀。"},
    {"id": "primordial_true_spirit", "name": "太初真灵", "worlds": ["nether"], "description": "保留第一代龙、凤、鲲、玄武等源流的上界真灵共同体。"},
    {"id": "self_ancestor", "name": "自脉妖祖", "worlds": ["nether"], "description": "拒绝依附太古祖名、以自身开创全新生命谱系的妖祖后裔。"},
    {"id": "worldtree_descendant", "name": "界树裔", "worlds": ["nether"], "description": "由诸界根网孕育的长生种，负责记录幽冥界的血脉迁徙。"},
    {"id": "chaos_beast", "name": "太荒异兽", "worlds": ["nether"], "description": "诞生于物种定型之前的太荒生命，形态与能力从不遵循后世分类。"}
