      "weight": 0.7,
      "intent_weights": {"treasure": 3.2, "travel": 1.8},
      "repeat": "once",
      "conditions": {"all": [
        {"path":"player.path","op":"eq","value":"monster"},
        {"path":"player.monster_species_id","op":"eq","value":"serpent"},
        {"path":"player.realm_index","op":"gte","value":1},
        {"not":{"path":"player.monster.imprints","op":"contains","value":"dragon_ancestry"}}
