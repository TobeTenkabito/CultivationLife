      "choices": [
        {"id":"awaken","text":"接受这段远祖回响","effects":[{"type":"grant_monster_imprint","imprint_id":"dragon_ancestry"}]},
        {"id":"refuse","text":"保持本相，不让祖血定义自己","effects":[{"type":"add_opportunity","value":8}]}
      ]
    },
