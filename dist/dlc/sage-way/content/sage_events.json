    {"id":"EVT_SAGE_RURAL_LECTURE","version":1,"title":"乡塾问礼","body":"乡民围坐在旧祠前，争论婚丧礼制该从古礼还是随时宜。","tags":["sage","world:human","teaching"],"weight":4,"intent_weights":{"sage_preach":2.8},"conditions":{"all":[{"path":"player.path","op":"eq","value":"confucian"},{"path":"player.world","op":"eq","value":"human"}]},"choices":[{"id":"rites","text":"据经典疏解旧礼","effects":[{"type":"add_opportunity","value":5},{"type":"restore_mp","value":-0.06}]},{"id":"custom","text":"因地制宜重订乡约","effects":[{"type":"add_karma","value":-2},{"type":"add_opportunity","value":3}]}]},
    {"id":"EVT_SAGE_CLASSIC_DISPUTE","version":1,"title":"三传异议","body":"门人各执《公羊》《谷梁》《左氏》一端，请你裁断同一段春秋笔法。","tags":["sage","teaching"],"weight":4,"intent_weights":{"sage_teach":3.0,"sage_answer":2.0},"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"compare","text":"并陈三传，辨其义例","effects":[{"type":"add_opportunity","value":6},{"type":"restore_mp","value":-0.08}]},{"id":"question","text":"反问门人各自立论","effects":[{"type":"add_opportunity","value":4}]}]},
    {"id":"EVT_SAGE_POOR_STUDENT","version":1,"title":"负笈寒生","body":"一名资质普通的寒门修士负笈而来，愿以十年苦功换一席旁听。","tags":["sage","world:human","disciple"],"weight":3,"intent_weights":{"sage_preach":2.5,"sage_teach":2.0},"conditions":{"all":[{"path":"player.path","op":"eq","value":"confucian"},{"path":"player.realm_index","op":"gte","value":3},{"path":"player.world","op":"eq","value":"human"}]},"choices":[{"id":"accept","text":"许其入席旁听","effects":[{"type":"add_karma","value":-3},{"type":"add_opportunity","value":3}]},{"id":"test","text":"先以经义试其心志","effects":[{"type":"add_opportunity","value":5}]}]},
    {"id":"EVT_SAGE_POWERFUL_INVITATION","version":1,"title":"权门延请","body":"当地豪强请你入府讲学，却暗示只讲忠顺、不谈民本。","tags":["sage","world:human","teaching"],"weight":3,"intent_weights":{"sage_preach":2.4},"conditions":{"all":[{"path":"player.path","op":"eq","value":"confucian"},{"path":"player.world","op":"eq","value":"human"}]},"choices":[{"id":"plain","text":"照讲王道，不避权门","effects":[{"type":"add_karma","value":-3},{"type":"damage","value":0.04}]},{"id":"decline","text":"托病辞去这场讲席","effects":[{"type":"restore_mp","value":0.08}]}]},
    {"id":"EVT_SAGE_STAR_SCRIPT","version":1,"title":"星文残简","body":"界河潮汐翻出一卷百族古文，字形各异，义理却与六经暗合。","tags":["sage","world:spirit","treasure"],"weight":4,"intent_weights":{"sage_answer":2.6,"sage_teach":1.8},"conditions":{"all":[{"path":"player.path","op":"eq","value":"confucian"},{"path":"player.world","op":"eq","value":"spirit"}]},"choices":[{"id":"collate","text":"逐字校勘，收入讲义","effects":[{"type":"add_opportunity","value":12},{"type":"restore_mp","value":-0.12}]},{"id":"share","text":"与百族学者共同释读","effects":[{"type":"add_karma","value":-4},{"type":"add_opportunity","value":8}]}]},
    {"id":"EVT_SAGE_RACE_RITES","version":1,"title":"百族礼争","body":"两族因祭祖次序几乎拔剑，请你为彼此都无成例的新礼作裁断。","tags":["sage","world:spirit","duty"],"weight":4,"intent_weights":{"sage_answer":2.8},"conditions":{"all":[{"path":"player.path","op":"eq","value":"confucian"},{"path":"player.world","op":"eq","value":"spirit"}]},"choices":[{"id":"common","text":"求其共同敬意，另立通礼","effects":[{"type":"add_karma","value":-5},{"type":"add_opportunity","value":10}]},{"id":"separate","text":"各循本俗，约定互不相侵","effects":[{"type":"add_opportunity","value":7}]}]},
    {"id":"EVT_SAGE_HEART_QUESTION","version":1,"title":"心上天理","body":"门人问：若亲情与公义相冲，所守之理究竟在经典，还是在此心？","tags":["sage","teaching"],"weight":4,"intent_weights":{"sage_answer":3.2},"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"principle","text":"先明公理，再安私情","effects":[{"type":"add_opportunity","value":7}]},{"id":"mind","text":"从不忍人之心推而广之","effects":[{"type":"add_karma","value":-2},{"type":"add_opportunity","value":6}]}]},
    {"id":"EVT_SAGE_TEXTUAL_FORGERY","version":1,"title":"伪经疑案","body":"一卷新出的古经能为某家学说增色，却有数处避讳暴露了后世伪作的痕迹。","tags":["sage","teaching","negative"],"weight":3,"intent_weights":{"sage_teach":2.4,"sage_answer":2.0},"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"expose","text":"公开考证，去伪存真","effects":[{"type":"add_opportunity","value":8},{"type":"restore_mp","value":-0.08}]},{"id":"preserve","text":"保留其中可取义理","effects":[{"type":"add_opportunity","value":4},{"type":"add_karma","value":1}]}]},
    {"id":"EVT_SAGE_HUMAN_ANNALS_001","version":1,"title":"县志少一页","body":"一名乡塾女弟子冒雨叩门，递来一册被血浸透的旧县志。三十年前赈灾册上的三百户人家，在新修县志中竟从未出生过；她的老师因追问此事被投入石渠县狱。","category":"sage_story","tags":["sage","story_chain","sage_human_annals","world:human","probability_gate"],"repeat":"once","weight":0,"trigger":{"milestone":"sage_human_annals_eligible","base_chance":0.35,"unit_increment":0.20},"conditions":{"all":[{"path":"player.path","op":"eq","value":"confucian"},{"path":"player.world","op":"eq","value":"human"},{"path":"player.realm_index","op":"eq","value":3},{"not":{"has_flag":"sage_human_annals_completed"}}]},"choices":[{"id":"take_case","text":"收下县志，亲赴石渠查明删名真相","effects":[{"type":"restore_mp","value":-0.08},{"type":"set_flag","flag":"sage_human_annals_investigating","text":"你在残页背后记下三百个被抹去的姓氏。"},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_002","text":"你循着县志纸张上的官印前往石渠粮仓。"}]},{"id":"send_students","text":"召集门人分头抄录，让证词先于原本传开","effects":[{"type":"add_opportunity","value":8},{"type":"set_flag","flag":"sage_human_annals_copies","text":"七份抄本连夜送往不同乡塾。"},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_002","text":"抄本中的旧印指向石渠粮仓。"}]}]},
    {"id":"EVT_SAGE_HUMAN_ANNALS_002","version":1,"title":"仓廪有鬼","body":"粮仓账簿记载，那三百户在灾年后仍年年纳粮；仓吏却说这些粮食从未入仓。账页夹层里藏着一枚县尊客卿的灵契，凡在契上留下名字的人，连后代记忆也会被慢慢抹去。","category":"sage_story","tags":["sage","story_chain","sage_human_annals","world:human","manual_only"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"open_granary","text":"当众开仓验粮，让百姓亲眼看清空账","effects":[{"type":"add_fame","value":5},{"type":"add_karma","value":-3},{"type":"set_flag","flag":"sage_human_annals_public","text":"仓门一开，空空如也的粮囤再无法用公文遮掩。"},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_003"}]},{"id":"trace_contract","text":"暂不惊动官府，沿灵契追查真正受益者","effects":[{"type":"restore_mp","value":-0.10},{"type":"add_opportunity","value":12},{"type":"set_flag","flag":"sage_human_annals_evidence","text":"你拓下灵契每一道转手印记。"},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_003"}]}]},
    {"id":"EVT_SAGE_HUMAN_ANNALS_003","version":1,"title":"堂上无席","body":"石渠县尊升堂，却撤去原告席，只摆出一张讲席请你论“民可使由之”。帘后，三位修士客卿正焚烧旧户籍；阶下百姓若敢报出亲人姓名，便会被灵契噤声。","category":"sage_story","tags":["sage","story_chain","sage_human_annals","world:human","manual_only"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"name_them","text":"不讲章句，逐一念出被删去者的姓名","effects":[{"type":"add_karma","value":-5},{"type":"add_fame","value":6},{"type":"set_flag","flag":"sage_human_annals_names_spoken","text":"每念出一名，灵契便裂开一道细纹。"},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_004"}]},{"id":"argue_law","text":"以县尊亲署的赈灾令反诘，使其无从曲解","effects":[{"type":"add_opportunity","value":15},{"type":"restore_mp","value":-0.12},{"type":"set_flag","flag":"sage_human_annals_law","text":"你用他自己的印信证明：被删去的人曾被官府承认为民。"},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_004"}]}]},
    {"id":"EVT_SAGE_HUMAN_ANNALS_004","version":1,"title":"焚塾之夜","body":"客卿见堂辩已败，趁夜放出火鸦焚烧藏有抄本的七座乡塾。领头的焚卷客卿堵在主塾前，要把人证、书证与三百个名字一并化为灰烬。","category":"sage_story","tags":["sage","story_chain","sage_human_annals","world:human","manual_only","combat"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"combat":{"target_name":"焚卷客卿","realm_offsets":[[0,0.78],[1,0.22]],"expectation_multiplier":0.92,"power_sigma":0.12,"power_bounds":[0.72,1.18]},"choices":[{"id":"hold_gate","text":"立于塾门之前，以浩然气正面退敌","effects":[{"type":"combat","lethal":false},{"type":"set_flag","flag":"sage_human_annals_battle_won","text":"火鸦在清光中溃散，焚卷客卿失手被擒。","if_result":["victory"]},{"type":"set_flag","flag":"sage_human_annals_battle_lost","text":"你未能守住主塾，却护着第一批学生从后门撤出。","if_result":["defeat"]},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_005","if_result":["victory","defeat"]}]},{"id":"save_people","text":"放弃纸本，先引师生与街坊撤离火场","effects":[{"type":"damage","value":0.10,"reason":"为救塾中众人被火鸦灼穿护体灵光"},{"type":"add_karma","value":-6,"if_result":["injured"]},{"type":"set_flag","flag":"sage_human_annals_people_saved","text":"纸张会烧尽，活人的记忆却被你保了下来。","if_result":["injured"]},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_005","if_result":["injured"]}]}]},
    {"id":"EVT_SAGE_HUMAN_ANNALS_005","version":1,"title":"三问于市","body":"县尊倒台后，乡民把贪墨者押到市前，问你三件事：旧粮如何偿、无名者如何归籍、后来掌印者又该受谁监督。惩一人很容易，难的是让下一任县尊无法再删掉同一页。","category":"sage_story","tags":["sage","story_chain","sage_human_annals","world:human","manual_only"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"public_covenant","text":"立乡约公议：账、印、仓三者不得归于一人","effects":[{"type":"add_karma","value":-4},{"type":"add_fame","value":8},{"type":"set_flag","flag":"sage_human_annals_covenant","text":"乡约由百姓、乡塾和新任仓吏共同用印。"},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_006"}]},{"id":"wandering_auditors","text":"设游学巡讲：每年由不同乡塾交叉核验县志","effects":[{"type":"add_opportunity","value":18},{"type":"set_flag","flag":"sage_human_annals_audit","text":"读书人第一次不仅替官府写字，也替无名者查账。"},{"type":"queue_event","event_id":"EVT_SAGE_HUMAN_ANNALS_006"}]}]},
    {"id":"EVT_SAGE_HUMAN_ANNALS_006","version":1,"title":"重修县志","body":"新县志落笔时，没有先写山川祥瑞，也没有先列历任县尊。第一页只写三百个曾被删去的姓名，末页则留白，约定后人若见不平，可继续补写。","category":"sage_story","tags":["sage","story_chain","sage_human_annals","world:human","manual_only","story_finale"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"leave_blank_page","text":"在末页题下“民有所呼，史有所应”","effects":[{"type":"add_item","item_id":"people_annals_bamboo"},{"type":"add_opportunity","value":24},{"type":"set_flag","flag":"sage_human_annals_completed","text":"《石渠民志》自此不再只由胜者书写。"}]},{"id":"return_to_school","text":"不留姓名，只把残卷送回重建的乡塾","effects":[{"type":"add_item","item_id":"people_annals_bamboo"},{"type":"add_karma","value":-6},{"type":"set_flag","flag":"sage_human_annals_completed","text":"孩子们从三百个名字开始读他们的新课。"}]}]},
    {"id":"EVT_SAGE_SPIRIT_COVENANT_001","version":1,"title":"天河译站","body":"灵界天河沿岸，十二族共用的译站忽然停止传讯。新颁的“同文灵律”能让所有文字自动化为一种天书，却也把无法直译的族名、誓词与祭歌判作杂音。第一批被抹去真名的异族学者请你主持公论。","category":"sage_story","tags":["sage","story_chain","sage_spirit_covenant","world:spirit","probability_gate"],"repeat":"once","weight":0,"trigger":{"milestone":"sage_spirit_covenant_eligible","base_chance":0.30,"unit_increment":0.18},"conditions":{"all":[{"path":"player.path","op":"eq","value":"confucian"},{"path":"player.world","op":"eq","value":"spirit"},{"path":"player.realm_index","op":"eq","value":6},{"not":{"has_flag":"sage_spirit_covenant_completed"}}]},"choices":[{"id":"hear_all","text":"暂停灵律，先听十二族各自说明不可译之处","effects":[{"type":"restore_mp","value":-0.12},{"type":"add_karma","value":-4},{"type":"set_flag","flag":"sage_spirit_covenant_many_voices","text":"十二种声音第一次没有被天书强行叠成一句。"},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_002"}]},{"id":"test_law","text":"亲自将神识接入天书，查明删字发生在哪一层法则","effects":[{"type":"damage","value":0.08,"reason":"神识被同文灵律反向抹除"},{"type":"add_opportunity","value":16,"if_result":["injured"]},{"type":"set_flag","flag":"sage_spirit_covenant_law_trace","text":"你在神识受创前看见了法则中的人为删改。","if_result":["injured"]},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_002","if_result":["injured"]}]}]},
    {"id":"EVT_SAGE_SPIRIT_COVENANT_002","version":1,"title":"百声入简","body":"羽族的方位写在风声里，石族以裂纹记世系，梦族醒来便忘记语音。若只把他们的意思翻成人族经文，天书仍会把真正重要的部分当作修辞删掉。","category":"sage_story","tags":["sage","story_chain","sage_spirit_covenant","world:spirit","manual_only"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"keep_forms","text":"保留声音、裂纹与梦痕，只为彼此建立索引","effects":[{"type":"add_opportunity","value":20},{"type":"set_flag","flag":"sage_spirit_covenant_forms","text":"你不再要求所有知识都先变成同一种字。"},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_003"}]},{"id":"shared_meanings","text":"先列不可伤害、不可冒名等共同底线","effects":[{"type":"add_karma","value":-5},{"type":"add_fame","value":5},{"type":"set_flag","flag":"sage_spirit_covenant_common_ground","text":"共同之义不再以消灭差异为代价。"},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_003"}]}]},
    {"id":"EVT_SAGE_SPIRIT_COVENANT_003","version":1,"title":"无字天书","body":"同文灵律的核心并非古圣遗物，而是一尊在界战中诞生的碑灵。它见过误译导致的万族战争，于是推演出唯一答案：只要世间只剩一种可被理解的声音，误解便会永远消失。","category":"sage_story","tags":["sage","story_chain","sage_spirit_covenant","world:spirit","manual_only"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"refute","text":"告诉碑灵：没有分歧的理解，只是服从","effects":[{"type":"add_fame","value":7},{"type":"set_flag","flag":"sage_spirit_covenant_refuted","text":"碑面第一次浮现出它无法自行化约的问题。"},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_004"}]},{"id":"show_memories","text":"开放识海，让它亲见不可被替代的十二族记忆","effects":[{"type":"restore_mp","value":-0.18},{"type":"add_opportunity","value":22},{"type":"set_flag","flag":"sage_spirit_covenant_memories","text":"碑灵看见同一个词在不同生命中拥有不同重量。"},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_004"}]}]},
    {"id":"EVT_SAGE_SPIRIT_COVENANT_004","version":1,"title":"同文之战","body":"碑灵拒绝停机，牵引整条天河的译阵化作“一律法身”。无数被删去的名字困在法身内部，若直接击碎核心，它们也会随天书一同消散。","category":"sage_story","tags":["sage","story_chain","sage_spirit_covenant","world:spirit","manual_only","combat"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"combat":{"target_name":"一律碑灵","realm_offsets":[[0,0.70],[1,0.30]],"expectation_multiplier":1.02,"power_sigma":0.10,"power_bounds":[0.84,1.22]},"choices":[{"id":"sever_indexes","text":"以浩然气逐层斩断法身索引，不伤其中真名","effects":[{"type":"combat","lethal":false},{"type":"set_flag","flag":"sage_spirit_covenant_battle_won","text":"法身崩解，而被囚真名化作群星归还诸族。","if_result":["victory"]},{"type":"set_flag","flag":"sage_spirit_covenant_battle_lost","text":"你被法身逐出天河，却记住了核心律文的破绽。","if_result":["defeat"]},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_005","if_result":["victory","defeat"]}]},{"id":"bear_law","text":"让天书暂时写入自身，为诸族撤出争取时间","effects":[{"type":"damage","value":0.16,"reason":"承受整条同文灵律时神魂崩散"},{"type":"add_karma","value":-7,"if_result":["injured"]},{"type":"set_flag","flag":"sage_spirit_covenant_sheltered","text":"你替所有不可译之声承受了片刻抹除。","if_result":["injured"]},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_005","if_result":["injured"]}]}]},
    {"id":"EVT_SAGE_SPIRIT_COVENANT_005","version":1,"title":"诸族大辩","body":"译阵停摆后，十二族必须决定新秩序。有人主张彻底废除共同文字，也有人仍想重造一部更温和的天书。你面前摆着的不是经义胜负，而是万族今后如何在保留自己的同时共同生活。","category":"sage_story","tags":["sage","story_chain","sage_spirit_covenant","world:spirit","manual_only"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"living_covenant","text":"立可修订的活约：共同底线由诸族定期重议","effects":[{"type":"add_karma","value":-6},{"type":"add_fame","value":10},{"type":"set_flag","flag":"sage_spirit_covenant_living_law","text":"没有任何一代人能把自己的解释永远封成天理。"},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_006"}]},{"id":"many_archives","text":"建十二座互译馆：共同索引，但原典各自保存","effects":[{"type":"add_opportunity","value":28},{"type":"set_flag","flag":"sage_spirit_covenant_archives","text":"差异不再被视为等待消除的错误。"},{"type":"queue_event","event_id":"EVT_SAGE_SPIRIT_COVENANT_006"}]}]},
    {"id":"EVT_SAGE_SPIRIT_COVENANT_006","version":1,"title":"万籁成章","body":"天河重新亮起时，每座译站都保留着十二种原声。旅人仍会误解，争论也不会消失；但任何名字被改写前，当事者终于拥有说“不”的位置。碑灵缩成一枚无字印，等待每一次共同落款。","category":"sage_story","tags":["sage","story_chain","sage_spirit_covenant","world:spirit","manual_only","story_finale"],"weight":0,"conditions":{"path":"player.path","op":"eq","value":"confucian"},"choices":[{"id":"sign_without_name","text":"以无字印作证，不让任何一族成为唯一正文","effects":[{"type":"add_item","item_id":"myriad_voices_blank_seal"},{"type":"add_opportunity","value":36},{"type":"set_flag","flag":"sage_spirit_covenant_completed","text":"天河万籁各有其声，也终于能够共同成章。"}]},{"id":"leave_to_twelve","text":"将无字印交给十二族轮流保管","effects":[{"type":"add_item","item_id":"myriad_voices_blank_seal"},{"type":"add_karma","value":-8},{"type":"set_flag","flag":"sage_spirit_covenant_completed","text":"共同秩序不再需要一位永恒的圣人替所有人发言。"}]}]}
